{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/ai-analyze.js": { "maxDuration": 60 },
    "api/check-registration.js": { "maxDuration": 60 },
    "api/crimes.js": { "maxDuration": 30 },
    "api/data.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
